# Copy to .env and adjust if needed.
# Leave unset (or delete this file) to use the default local SQLite DB.
DATABASE_URL=postgresql://dqp:dqp_local_dev@localhost:5432/dqp

# Knowledge Search access codes (all optional - these are the defaults).
# They're demo values and the page prints them in a "Demo codes" box, so a
# visitor can try each level. That suits a public demo that only holds sample
# data. If real documents will ever go on the site, set your own two codes and
# ID number and turn the box off (SHOW_ACCESS_HINT=false).
# Confidential takes two things: its code, then a 5-digit ID number typed on a
# phone-style pad. The ID must be exactly 5 digits or the app won't start.
# TEAM_ACCESS_CODE=280010
# CONFIDENTIAL_ACCESS_CODE=938032
# CONFIDENTIAL_ID_NUMBER=69712
# SHOW_ACCESS_HINT=true

# Upload limits (all optional - these are the defaults). One big file can use
# hundreds of MB while it is checked, so these keep a single upload from taking
# the site down; going over one is a plain "413" message. What each one stops is
# in the README ("Try a sample, and upload limits"). The defaults take a 25 MB
# file and suit a laptop or a host with a gigabyte or two to spare. On a small
# host - Render's free plan has 512 MB in all, most of it used by the search
# model - use MAX_UPLOAD_MB=5, MAX_CHECK_ROWS=30000, MAX_REFERENCE_FILES=1 and
# MAX_CONCURRENT_UPLOADS=1.
# MAX_UPLOAD_MB=25
# MAX_CHECK_ROWS=1000000
# MAX_CHECK_COLUMNS=100
# MAX_CHECK_CELLS=6000000
# MAX_REFERENCE_FILES=3
# MAX_INCIDENT_ROWS=25000
# MAX_DOCUMENT_CHUNKS=1000
# MAX_CONCURRENT_UPLOADS=2
